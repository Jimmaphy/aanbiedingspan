<!doctype html><html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>#(pageTitle) · Aanbiedingspan</title><link rel="stylesheet" href="/css/app.css?v=2"></head><body><a class="skip-link" href="#main-content">Ga naar de inhoud</a>
<header class="site-header admin-header"><a class="brand" href="/admin"><img src="/images/aanbiedingspan-logo.svg" alt="" width="48" height="48">Aanbiedingspan beheer</a><nav aria-label="Beheer"><a href="/admin">Overzicht</a><span>Ingelogd als #(username)</span><form action="/admin/logout" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><button class="text-button" type="submit">Uitloggen</button></form></nav></header>
<main id="main-content" class="admin-shell"><div class="admin-title"><div><p class="eyebrow">Catalogusbeheer</p><h1>#(heading)</h1><p>#(introduction)</p></div><a class="button" href="#(basePath)/new">#(createLabel)</a></div>
<form class="admin-search" action="#(basePath)" method="get" role="search"><label for="admin-search">Zoeken in #(heading)</label><div><input id="admin-search" type="search" name="q" value="#(searchTerm)" maxlength="100"><button class="button" type="submit">Zoeken</button>#if(searchResultMessage):<a class="button button-secondary" href="#(basePath)">Wissen</a>#endif</div></form>
#if(searchResultMessage):<p class="form-status" role="status">#(searchResultMessage)</p>#endif
<div class="admin-list" role="list">#for(item in items):<article role="listitem"><div><h2>#(item.title)</h2>#if(item.detail):<p>#(item.detail)</p>#endif</div><div class="row-actions"><a class="button button-secondary" href="#(basePath)/#(item.id)/edit">Wijzigen</a><form action="#(basePath)/#(item.id)/delete" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><button class="danger-button" type="submit">Verwijderen</button></form></div></article>#endfor</div>
#if(items.isEmpty):<div class="empty-state"><h2>Nog niets om te tonen</h2><p>#(emptyMessage)</p></div>#endif
<nav class="pagination" aria-label="Paginering">#if(previousPath):<a class="button button-secondary" href="#(previousPath)">Vorige pagina</a>#endif #if(nextPath):<a class="button button-secondary" href="#(nextPath)">Volgende pagina</a>#endif</nav></main></body></html>
