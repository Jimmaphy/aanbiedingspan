#extend("layouts/admin"):
#export("head"):<!-- Geen extra paginabronnen. -->#endexport
#export("body"):
<main id="main-content" class="admin-narrow"><p class="eyebrow">Websitebeheer</p><h1>#(heading)</h1><p class="lead">Dit adres verschijnt op de pagina “Over Aanbiedingspan”. Zonder adres blijft daar de tijdelijke uitleg staan.</p>
<form class="admin-panel form-stack" action="/admin/contact-information" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><label>Openbaar e-mailadres<input type="email" name="email" value="#(email)" autocomplete="email" required maxlength="254" placeholder="contact@aanbiedingspan.nl"></label><div class="form-actions"><button class="button" type="submit">Contactgegevens opslaan</button><a href="/admin">Annuleren</a></div></form></main>#endexport
#endextend
