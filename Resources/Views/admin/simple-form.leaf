#extend("layouts/admin"):
#export("head"):<!-- Geen extra paginabronnen. -->#endexport
#export("body"):
<main id="main-content" class="admin-narrow"><p class="eyebrow">Catalogusbeheer</p><h1>#(heading)</h1>#if(errorMessage):<div class="alert" role="alert">#(errorMessage)</div>#endif
<form class="admin-panel form-stack" action="#(action)" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><label>Naam<input name="name" value="#(name)" required maxlength="120"></label>#if(showsWebsiteURL):<label>Websiteadres <span class="optional">(niet verplicht)</span><input type="url" name="websiteURL" value="#(websiteURL)" maxlength="2000" placeholder="https://voorbeeld.nl"></label>#endif<div class="form-actions"><button class="button" type="submit">Opslaan</button><a href="#(cancelPath)">Annuleren</a></div></form></main>#endexport
#endextend
