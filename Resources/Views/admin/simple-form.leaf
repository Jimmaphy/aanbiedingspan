<!doctype html><html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>#(pageTitle) · Aanbiedingspan</title><link rel="stylesheet" href="/css/app.css"></head><body><a class="skip-link" href="#main-content">Ga naar de inhoud</a>
<header class="site-header admin-header"><a class="brand" href="/admin"><img src="/images/aanbiedingspan-logo.svg" alt="" width="48" height="48">Aanbiedingspan beheer</a><nav aria-label="Beheer"><a href="/admin">Overzicht</a><span>Ingelogd als #(username)</span></nav></header>
<main id="main-content" class="admin-narrow"><p class="eyebrow">Catalogusbeheer</p><h1>#(heading)</h1>#if(errorMessage):<div class="alert" role="alert">#(errorMessage)</div>#endif
<form class="admin-panel form-stack" action="#(action)" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><label>Naam<input name="name" value="#(name)" required maxlength="120"></label>#if(showsWebsiteURL):<label>Websiteadres <span class="optional">(niet verplicht)</span><input type="url" name="websiteURL" value="#(websiteURL)" maxlength="2000" placeholder="https://voorbeeld.nl"></label>#endif<div class="form-actions"><button class="button" type="submit">Opslaan</button><a href="#(cancelPath)">Annuleren</a></div></form></main></body></html>
