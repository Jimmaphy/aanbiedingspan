<!doctype html><html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>#(pageTitle) · Aanbiedingspan</title><link rel="stylesheet" href="/css/app.css"><script src="/js/ingredient-picker.js?v=2" defer></script><script src="/js/admin.js" defer></script></head><body><a class="skip-link" href="#main-content">Ga naar de inhoud</a>
<header class="site-header admin-header"><a class="brand" href="/admin"><img src="/images/aanbiedingspan-logo.svg" alt="" width="48" height="48">Aanbiedingspan beheer</a><nav aria-label="Beheer"><a href="/admin/recipes">Recepten</a><span>Ingelogd als #(username)</span></nav></header>
<main id="main-content" class="admin-shell"><p class="eyebrow">Catalogusbeheer</p><h1>#(heading)</h1>#if(errorMessage):<div class="alert" role="alert">#(errorMessage)</div>#endif
<div class="admin-form-layout"><form class="admin-panel form-stack" data-admin-main-form action="#(action)" method="post" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="#(csrfToken)">
<label>Titel<input name="title" value="#(title)" required maxlength="120"></label>
<label>Korte samenvatting<textarea name="summary" required maxlength="500" rows="4">#(summary)</textarea></label>
<label>Receptbron<select name="sourceID" required><option value="">Kies een bron</option>#for(option in sources):<option value="#(option.id)" #(option.selectedAttribute)>#(option.name)</option>#endfor</select></label>
<label>Link naar het recept<input type="url" name="sourceURL" value="#(sourceURL)" required maxlength="2000" placeholder="https://voorbeeld.nl/recept"></label>
<label>Bereidingstijd in minuten<input type="number" name="durationMinutes" value="#(durationMinutes)" min="1" max="1440" required></label>
<label>Afbeelding <span class="optional">(niet verplicht)</span><input type="file" name="image" accept="image/jpeg,image/png,image/webp" aria-describedby="image-help"></label><p id="image-help" class="field-help">Gebruik een JPEG-, PNG- of WebP-afbeelding van maximaal 5 MB.</p>
#if(imagePath):<div class="current-recipe-image"><p>Huidige afbeelding</p><img src="#(imagePath)" alt="Huidige afbeelding van dit recept" width="320" height="180"></div>#endif
<fieldset><legend>Gerechtswensen</legend><p class="field-help">Kies de tags die ook in stap 1 van de wizard staan.</p><div class="choice-grid">#for(option in dietaryPreferences):<label class="choice-card"><input type="checkbox" name="dietaryPreferenceIDs[]" value="#(option.id)" #(option.checkedAttribute)><span>#(option.name)</span></label>#endfor</div></fieldset>
<fieldset><legend>Ingrediënten</legend><p class="field-help">Zoek en kies minimaal één ingrediënt. Hoeveelheden en maten zijn niet nodig.</p>
<div class="ingredient-picker" data-ingredient-picker><label>Zoek een ingrediënt<input type="search" data-ingredient-search autocomplete="off"></label><p class="form-status" data-ingredient-status role="status" aria-live="polite"></p><div class="ingredient-results" data-ingredient-results aria-label="Zoekresultaten">#for(option in ingredients):<label data-ingredient-option data-ingredient-name="#(option.name)"><input type="checkbox" name="ingredientIDs[]" value="#(option.id)" #(option.checkedAttribute)><span>#(option.name)</span></label>#endfor</div><h2 class="selection-heading">Geselecteerde ingrediënten</h2><p class="field-help" data-ingredient-empty>Nog geen ingrediënten gekozen.</p><div class="ingredient-selection" data-ingredient-selected></div></div></fieldset>
<div class="form-actions"><button class="button" type="submit">Opslaan</button><a href="/admin/recipes">Annuleren</a></div></form>
<aside class="quick-create" aria-labelledby="quick-heading"><h2 id="quick-heading">Ontbreekt er iets?</h2><form class="form-stack" data-quick-create data-create-kind="ingredient" action="/admin/ingredients" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><input type="hidden" name="returnTo" value="#(returnPath)"><label>Nieuw ingrediënt<input name="name" required maxlength="120"></label><button class="button button-secondary" type="submit">Ingrediënt toevoegen</button><p class="form-status" data-quick-status role="status" aria-live="polite"></p></form><form class="form-stack" data-quick-create data-create-kind="recipeSource" action="/admin/recipe-sources" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><input type="hidden" name="returnTo" value="#(returnPath)"><label>Nieuwe receptbron<input name="name" required maxlength="120"></label><label>Websiteadres <span class="optional">(niet verplicht)</span><input type="url" name="websiteURL" maxlength="2000"></label><button class="button button-secondary" type="submit">Receptbron toevoegen</button><p class="form-status" data-quick-status role="status" aria-live="polite"></p></form><form class="form-stack" data-quick-create data-create-kind="dietaryPreference" action="/admin/dietary-preferences" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><input type="hidden" name="returnTo" value="#(returnPath)"><label>Nieuwe gerechtswens<input name="name" required maxlength="120"></label><button class="button button-secondary" type="submit">Gerechtswens toevoegen</button><p class="form-status" data-quick-status role="status" aria-live="polite"></p></form></aside></div></main></body></html>
