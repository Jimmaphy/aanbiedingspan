<!doctype html><html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>#(pageTitle) · Aanbiedingspan</title><link rel="stylesheet" href="/css/app.css"><script src="/js/ingredient-picker.js?v=2" defer></script><script src="/js/admin.js" defer></script></head><body><a class="skip-link" href="#main-content">Ga naar de inhoud</a>
<header class="site-header admin-header"><a class="brand" href="/admin"><img src="/images/aanbiedingspan-logo.svg" alt="" width="48" height="48">Aanbiedingspan beheer</a><nav aria-label="Beheer"><a href="/admin/offers">Aanbiedingen</a><span>Ingelogd als #(username)</span></nav></header>
<main id="main-content" class="admin-shell"><p class="eyebrow">Catalogusbeheer</p><h1>#(heading)</h1>#if(errorMessage):<div class="alert" role="alert">#(errorMessage)</div>#endif
<div class="admin-form-layout"><form class="admin-panel form-stack" data-admin-main-form action="#(action)" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><label>Supermarkt<select name="supermarketID" required><option value="">Kies een supermarkt</option>#for(option in supermarkets):<option value="#(option.id)" #(option.selectedAttribute)>#(option.name)</option>#endfor</select></label><div class="two-columns"><label>Geldig vanaf<input type="date" name="validFrom" value="#(validFrom)" required></label><label>Geldig tot en met<input type="date" name="validUntil" value="#(validUntil)" required></label></div>
<fieldset><legend>Producten in de aanbieding</legend><p class="field-help">Zoek en kies alle ingrediënten van deze aanbieding. Kies minimaal één ingrediënt.</p><div class="ingredient-picker" data-ingredient-picker><label>Zoek een ingrediënt<input type="search" data-ingredient-search autocomplete="off"></label><p class="form-status" data-ingredient-status role="status" aria-live="polite"></p><div class="ingredient-results" data-ingredient-results aria-label="Zoekresultaten">#for(option in ingredients):<label data-ingredient-option data-ingredient-name="#(option.name)"><input type="checkbox" name="ingredientIDs[]" value="#(option.id)" #(option.checkedAttribute)><span>#(option.name)</span></label>#endfor</div><h2 class="selection-heading">Geselecteerde ingrediënten</h2><p class="field-help" data-ingredient-empty>Nog geen ingrediënten gekozen.</p><div class="ingredient-selection" data-ingredient-selected></div></div></fieldset>
<div class="form-actions"><button class="button" type="submit">Opslaan</button><a href="/admin/offers">Annuleren</a></div></form>
<aside class="quick-create" aria-labelledby="quick-heading"><h2 id="quick-heading">Ontbreekt er iets?</h2><form class="form-stack" data-quick-create data-create-kind="ingredient" action="/admin/ingredients" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><input type="hidden" name="returnTo" value="#(returnPath)"><label>Nieuw ingrediënt<input name="name" required maxlength="120"></label><button class="button button-secondary" type="submit">Ingrediënt toevoegen</button><p class="form-status" data-quick-status role="status" aria-live="polite"></p></form><form class="form-stack" data-quick-create data-create-kind="supermarket" action="/admin/supermarkets" method="post"><input type="hidden" name="csrfToken" value="#(csrfToken)"><input type="hidden" name="returnTo" value="#(returnPath)"><label>Nieuwe supermarkt<input name="name" required maxlength="120"></label><button class="button button-secondary" type="submit">Supermarkt toevoegen</button><p class="form-status" data-quick-status role="status" aria-live="polite"></p></form></aside></div></main></body></html>
